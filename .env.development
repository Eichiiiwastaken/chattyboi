REDIS_URL=redis://localhost:63799
AUTH_SECRET=chattyboi-local-development-secret-do-not-use-in-production
NEXTAUTH_URL=http://localhost:3000
ALLOWED_USERS='[{"username":"local-dev","name":"Local Developer","password":"local-dev"}]'
